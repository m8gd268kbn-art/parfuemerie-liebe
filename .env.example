# Parfümerie Liebe – Umgebungsvariablen
# Kopieren nach .env.local und ausfüllen. Niemals echte Schlüssel committen.

# Datenbank (lokal oder Supabase: Settings → Database → Connection string)
# Für den Supabase-Transaction-Pooler (Port 6543) wird prepare automatisch deaktiviert.
DATABASE_URL=postgres://liebe:liebe_dev@localhost:5432/liebe

# Öffentliche Basis-URL (Canonicals, E-Mail-Links, Webhook-Rücksprung)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zahlung: "stripe" (Produktion) oder "test" (nur Entwicklung/E2E, in Produktion gesperrt)
PAYMENT_PROVIDER=test
# ALLOW_TEST_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TEST_PAYMENT_SECRET=bitte-einen-langen-zufallswert-setzen

# E-Mail: "resend" oder "outbox" (Entwicklung: speichert Mails in der DB, sichtbar im Admin)
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM="Parfümerie Liebe <shop@example.invalid>"

# Bilder-Speicher: "local" (public/uploads) oder "supabase"
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Zeigt den Hinweis „Demo-Daten“ im Shop
NEXT_PUBLIC_DEMO_MODE=true

# Nur für das Seed-Skript: erster Admin-Zugang
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=
